{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Wins",
  "version": "1.0.0",
  "identifier": "app.tinywins.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tiny Wins",
        "width": 420,
        "height": 900,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
